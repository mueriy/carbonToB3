field f: Int

method swap(a: Ref, b: Ref)
  requires acc(a.f, write) && acc(b.f, write)
  requires a != b
  ensures acc(a.f, write) && acc(b.f, write)
  ensures b.f == old(a.f) && a.f == old(b.f)
{
  var tmp: Int
  tmp := a.f
  a.f := b.f
  b.f := tmp
}

method client()
{
  var x: Ref
  var y: Ref
  var z: Ref
  x := new(f)
  y := new(f)
  x.f := 3
  y.f := 4
  swap(x, y)
  assert x.f == 4
  assert y.f == 3
  z := x
}


method f0_1(v0_0: Int) returns (value: Int)
  requires 0 <= v0_0 && v0_0 < 10
{
  value := v0_0
}

