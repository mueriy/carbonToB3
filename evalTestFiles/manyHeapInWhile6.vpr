method foo2(x: Ref)
  requires acc(x.fint0)
  requires acc(x.fint1)
  requires acc(x.fint2)
  requires acc(x.fint3)
  requires acc(x.fint4)
  requires acc(x.fint5)
  // requires acc(x.fint6)
  // requires acc(x.fint7)
  // requires acc(x.fint8)
  // requires acc(x.fint9)
  // requires acc(x.fint10)
  // requires acc(x.fint11)
  // requires acc(x.fint12)
  // requires acc(x.fint13)
  // requires acc(x.fint14)
  // requires acc(x.fint15)
{
  var i: Int := 1
  while (i != 0)
    invariant i >= 0
    invariant acc(x.fint0)
    invariant acc(x.fint1)
    invariant acc(x.fint2)
    invariant acc(x.fint3)
    invariant acc(x.fint4)
    invariant acc(x.fint5)
    // invariant acc(x.fint6)
    // invariant acc(x.fint7)
    // invariant acc(x.fint8)
    // invariant acc(x.fint9)
    // invariant acc(x.fint10)
    // invariant acc(x.fint11)
    // invariant acc(x.fint12)
    // invariant acc(x.fint13)
    // invariant acc(x.fint14)
    // invariant acc(x.fint15)
    { i := i - 1}
  assert i == 0
  assert false
}