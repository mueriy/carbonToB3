procedure iflot(){
  var x: int := 0

  if (true) { x := x + 1 } 
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 }
  if (true) { x := x + 1 } 
  if (true) { x := x + 1 } // (17) 36s B3; 1s Boogie
  //if (true) { x := x + 1 }
  //if (true) { x := x + 1 } // (19) 144s B3; 2s Boogie
  //if (true) { x := x + 1 }
  assert x == 16
}

