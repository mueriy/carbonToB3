method antiCheck(x: Int) returns (N: Int)
  requires x > 0
  ensures N > 1
{
    var N2: Int

    assume N > 0
    assert x == x
    assert (forall i: Int, j: Int ::
      (0 <= i && i < N) && (0 <= j && j < N) 
        ==> (i * j <= N * N))
    assert (forall i: Int, j: Int, k: Int ::
      (0 <= i && i <= N) &&( 0 <= j && j <= N) && (0 <= k && k <= N )
        ==> i * j <= (N * N)+k)
    N := x + 1

}